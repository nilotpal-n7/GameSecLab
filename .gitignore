# ── Binaries & archives anywhere in the lab (re-download/rebuild instructions live in NOTES.md) ──
*.exe
*.dll
*.sys
*.pdb
*.zip
*.7z
*.snap
*.i64
*.scandata
*.scandata.*

# ── Per-title workspaces: track src/, recovery/, config.py, README, screenshots; drop heavy dumps ──
# Each title's binaries, snapshots, IDA dumps, traces, logs and imports live under targets/<title>/dumps/.
targets/**/dumps/

# ── REAForge generated/runtime files (keep code + READMEs, drop outputs) ──
reaforge/capabilities.json
reaforge/facts.json
reaforge/llm_prompt.txt
reaforge/llm_reply.txt
reaforge/bridge/
**/__pycache__/
*.pyc

# ── Intel Pin lab artifacts ──
*.log
**/obj-intel64/
**/obj-ia32/

# ── vmlab: keep source + notes, ignore built binaries ──
vmlab/*.exe
vmlab/a.out
vmlab/keycheck_plain_elf
vmlab/keycheck_vm
vmlab/keycheck_vm2
vmlab/keycheck_ad
vmlab/keycheck_ad_vm
vmlab/ghidra_proj/

# ── Editor / OS noise ──
.vscode/
Thumbs.db
desktop.ini

# Python virtualenv (local; recreate with: python -m venv .venv + pip install -r requirements.txt)
.venv/
