# ── Binaries & archives anywhere in the lab (re-download/rebuild instructions live in NOTES.md) ──
*.exe
*.dll
*.sys
*.pdb
*.zip
*.7z
*.snap
*.i64
*.scandata
*.scandata.*

# ── Per-title workspaces: track src/, recovery/, config.py, README, screenshots; drop heavy dumps ──
# Each title's binaries, snapshots, IDA dumps, traces, logs and imports live under targets/<title>/dumps/.
targets/**/dumps/

# ── system_informer: the Ed25519 issuer PRIVATE key is the entire security root — never commit it;
#    issued .sipm licenses are regenerable from the signer, so keep them out of git too. ──
targets/system_informer/issuer_keys/
targets/system_informer/licenses/
# Inno Setup build output (the setup exe is regenerable from the .iss).
targets/system_informer/installer/Output/

# ── REAForge generated/runtime files (keep code + READMEs, drop outputs) ──
reaforge/capabilities.json
reaforge/facts.json
reaforge/llm_prompt.txt
reaforge/llm_reply.txt
reaforge/bridge/
**/__pycache__/
*.pyc

# ── Intel Pin lab artifacts ──
*.log
**/obj-intel64/
**/obj-ia32/

# ── vmlab: keep source + notes, ignore built binaries ──
vmlab/*.exe
vmlab/a.out
vmlab/keycheck_plain_elf
vmlab/keycheck_vm
vmlab/keycheck_vm2
vmlab/keycheck_ad
vmlab/keycheck_ad_vm
vmlab/ghidra_proj/

# ── Editor / OS noise ──
.vscode/
Thumbs.db
desktop.ini

# Python virtualenv (local; recreate with: python -m venv .venv + pip install -r requirements.txt)
.venv/
temp.txt

# System Informer break: raw run logs + preserved locked binaries (artifacts; FINDINGS.md is the tracked index)
targets/system_informer/evidence/logs/
targets/system_informer/evidence/locked_binaries/
