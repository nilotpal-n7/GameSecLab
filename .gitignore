# Practice games are large third-party binaries: keep them out of the repo.
# Re-download instructions live in NOTES.md.
targets/

# Binaries and archives anywhere in the lab
*.exe
*.dll
*.sys
*.pdb
*.zip
*.7z

# Big generated output: commit curated results (e.g. offsets.json), not raw dumps
dumps/**
!dumps/.gitkeep
!dumps/*.md

# Editor / OS noise
.vscode/
Thumbs.db
desktop.ini

# vmlab: keep source + notes, ignore built binaries
vmlab/*.exe
vmlab/keycheck_vm
vmlab/keycheck_vm.c
vmlab/ghidra_proj/
vmlab/keycheck_plain_elf
vmlab/keycheck_vm
vmlab/keycheck_vm2
vmlab/a.out
!vmlab/keycheck_vm.c
!vmlab/keycheck_vm2.c
vmlab/keycheck_ad
vmlab/keycheck_ad_vm
!vmlab/keycheck_ad.c
!vmlab/keycheck_ad_vm.c

# REAForge generated/runtime files (keep code + README, drop outputs)
reaforge/capabilities.json
reaforge/facts.json
reaforge/llm_prompt.txt
reaforge/llm_reply.txt
reaforge/__pycache__/
reaforge/bridge/
capstone/*.exe
capstone/*.i64
capstone/ida_decompile.txt

# Intel Pin lab artifacts
*.log
**/obj-intel64/
**/obj-ia32/
